From 933193f59b538a81e07ae9c3eab3ace421c8be6b Mon Sep 17 00:00:00 2001
From: Stanley5249 <seer852741@gmail.com>
Date: Wed, 28 Oct 2026 07:33:02 +0800
Subject: [PATCH] Count wall clock time in steps so a core never reads the same
 time twice

The wall clock registers returned g_clock, which advances once per
libttsim_clock call. Within one clock, a busy Tensix tile is clocked
repeatedly while it executes Tensix instructions, and a busy eth core
takes up to ETH_BUSY_STEPS steps. Every one of those steps read the
same wall clock, so code that timestamps events, such as the
tt-metal device profiler, recorded distinct events at one time.

The registers now count steps: each repeated tile clock or eth step
reads one more than the last, and the wall clock advances by the
most steps any core took in the clock. g_clock, PAUSE, and the eth
busy window still count clocks, so only wall clock reads change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libttsim.cpp | 10 ++++++++--
 src/sim.cpp      |  3 +++
 src/sim.h        |  6 ++++++
 src/tile.cpp     |  6 +++---
 4 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/src/libttsim.cpp b/src/libttsim.cpp
index ecaf6e1..3c14c2e 100644
--- a/src/libttsim.cpp
+++ b/src/libttsim.cpp
@@ -250,7 +250,8 @@ static void clock_current_chip() {
     for (uint32_t tile_id = next_busy_t_tile(0); tile_id < NUM_T_TILES; tile_id = next_busy_t_tile(tile_id + 1)) {
         TensixTile *p_tile = &g_t_tiles[tile_id];
         // Hack: for simulator perf, we clock a tile repeatedly as long as it successfully executes at least one Tensix instruction
-        for (;;) {
+        for (g_wall_step = 0;; g_wall_step++) {
+            g_wall_steps_max = std::max(g_wall_steps_max, g_wall_step + 1);
             for (uint32_t rv32_mask = p_tile->rv32_cores_active; rv32_mask; rv32_mask &= rv32_mask - 1) {
                 uint32_t rv32_index = __builtin_ctz(rv32_mask);
                 rv32_step(&p_tile->rv32[rv32_index]);
@@ -285,6 +286,7 @@ static void clock_current_chip() {
             g_t_tiles_busy[tile_id / 64] &= ~(1ull << (tile_id % 64));
         }
     }
+    g_wall_step = 0;
     for (uint64_t rv32_mask = g_rv32_cores_active; rv32_mask; rv32_mask &= rv32_mask - 1) {
         uint32_t core_index = __builtin_ctzll(rv32_mask);
         uint32_t tile_id = core_index / RV32_CORES_PER_E_TILE;
@@ -293,7 +295,8 @@ static void clock_current_chip() {
         // Hack: for simulator perf, an eth core busy lately (its sram written to, or it issued a NOC or eth command)
         // takes several steps per clock, so relayed traffic doesn't wait on it; an idle one takes one
         uint32_t steps = (g_clock < g_e_tiles[tile_id].busy_until) ? ETH_BUSY_STEPS : 1;
-        for (uint32_t i = 0; (i < steps) && ((g_rv32_cores_active >> core_index) & 1); i++) {
+        for (g_wall_step = 0; (g_wall_step < steps) && ((g_rv32_cores_active >> core_index) & 1); g_wall_step++) {
+            g_wall_steps_max = std::max(g_wall_steps_max, g_wall_step + 1);
             rv32_step(p_hart);
         }
     }
@@ -309,6 +312,9 @@ extern "C" API_EXPORT void libttsim_clock(uint32_t n_clocks) {
             clock_current_chip();
         }
         g_clock++; // single global timebase, advanced once per clock across all chips
+        g_wall_clock += std::max(g_wall_steps_max, 1u);
+        g_wall_step = 0;
+        g_wall_steps_max = 0;
     }
     ttsim_select_chip(saved_chip_id);
 }
diff --git a/src/sim.cpp b/src/sim.cpp
index c6840d2..cc5ad34 100644
--- a/src/sim.cpp
+++ b/src/sim.cpp
@@ -15,6 +15,9 @@ ChipState g_chips[std::max(NUM_CHIPS, NUM_MMIO_CHIPS)]; // an MMIO chip's PCIe t
 uint32_t g_current_chip_id;
 ChipState *g_chip = g_chips;
 uint64_t g_clock;
+uint64_t g_wall_clock;
+uint32_t g_wall_step;
+uint32_t g_wall_steps_max;

 uint64_t ttsim_get_clock() {
     return g_clock;
diff --git a/src/sim.h b/src/sim.h
index d8c9768..4fb8e54 100644
--- a/src/sim.h
+++ b/src/sim.h
@@ -591,6 +591,12 @@ extern ChipState g_chips[]; // not hidden: small-model code then reaches it thro
 extern uint32_t g_current_chip_id;
 extern ChipState *g_chip; // &g_chips[g_current_chip_id]
 extern uint64_t g_clock;
+// The wall clock registers count steps, not clocks: a clock that steps a core several times gives each step its own
+// time, so a core never reads the same time twice. g_wall_clock is the first step of the current clock and
+// g_wall_step the step a core is taking within it.
+extern uint64_t g_wall_clock;
+extern uint32_t g_wall_step;
+extern uint32_t g_wall_steps_max;

 // XXX transitional
 #define g_t_tiles g_chip->t_tiles
diff --git a/src/tile.cpp b/src/tile.cpp
index 48d5b10..8e8483e 100644
--- a/src/tile.cpp
+++ b/src/tile.cpp
@@ -1031,9 +1031,9 @@ static uint32_t riscv_debug_regs_rd32(uint32_t tile_id, uint32_t tensix_id, uint
             }
             TTSIM_ERROR(UnsupportedFunctionality, "TENSIX_CREG_RDDATA in eth tile");
         case RISCV_DEBUG_REGS_SOFT_RESET_0: return p_tile->soft_reset_0;
-        case RISCV_DEBUG_REGS_WALL_CLOCK_0: return uint32_t(g_clock);
-        case RISCV_DEBUG_REGS_WALL_CLOCK_1: return uint32_t(g_clock >> 32); // high part, unlatched
-        case RISCV_DEBUG_REGS_WALL_CLOCK_1_AT: return uint32_t(g_clock >> 32); // XXX add the latching behavior on this reg
+        case RISCV_DEBUG_REGS_WALL_CLOCK_0: return uint32_t(g_wall_clock + g_wall_step);
+        case RISCV_DEBUG_REGS_WALL_CLOCK_1: return uint32_t((g_wall_clock + g_wall_step) >> 32); // high part, unlatched
+        case RISCV_DEBUG_REGS_WALL_CLOCK_1_AT: return uint32_t((g_wall_clock + g_wall_step) >> 32); // XXX add the latching behavior on this reg
 #if TT_ARCH_VERSION == 1
         case RISCV_DEBUG_REGS_TRISC_RESET_PC_OVERRIDE:
             if constexpr (tile_type == 'T') {
