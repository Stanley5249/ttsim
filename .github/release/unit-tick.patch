From 234317d3b7a61b86f92705fbb1115abe0dd9ac40 Mon Sep 17 00:00:00 2001
From: Stanley5249 <seer852741@gmail.com>
Date: Tue, 10 Nov 2026 01:23:19 +0800
Subject: [PATCH] Step each tile and eth core once per clock so a core never
 reads the same time twice

The wall clock registers return g_clock, which advances once per
libttsim_clock call. Within one clock, upstream clocks a busy Tensix
tile repeatedly while it executes Tensix instructions, and a busy eth
core takes up to ETH_BUSY_STEPS steps. Every one of those steps read
the same wall clock, so code that timestamps events, such as the
tt-metal device profiler, recorded distinct events at one time.

Each Tensix tile and each eth core now takes exactly one step per
clock. With one step per core per clock, g_clock already gives each
step its own time, so the wall clock registers stay as upstream and
the change adds no state. The cost is simulator speed: a busy tile or
eth core needs more clocks to do the same work.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libttsim.cpp | 12 +++++-------
 src/tensix.cpp   | 36 ++++++++++++++++++++++++++++--------
 2 files changed, 33 insertions(+), 15 deletions(-)

diff --git a/src/libttsim.cpp b/src/libttsim.cpp
index ecaf6e1..ce70314 100644
--- a/src/libttsim.cpp
+++ b/src/libttsim.cpp
@@ -249,7 +249,8 @@ static void clock_current_chip() {
     // clocked this cycle.
     for (uint32_t tile_id = next_busy_t_tile(0); tile_id < NUM_T_TILES; tile_id = next_busy_t_tile(tile_id + 1)) {
         TensixTile *p_tile = &g_t_tiles[tile_id];
-        // Hack: for simulator perf, we clock a tile repeatedly as long as it successfully executes at least one Tensix instruction
+        // Unit tick: a tile takes one step per clock, so each core reads a new wall clock value on every step.
+        // Upstream clocks a busy tile repeatedly for simulator perf, which repeats the wall clock within one clock.
         for (;;) {
             for (uint32_t rv32_mask = p_tile->rv32_cores_active; rv32_mask; rv32_mask &= rv32_mask - 1) {
                 uint32_t rv32_index = __builtin_ctz(rv32_mask);
@@ -277,9 +278,7 @@ static void clock_current_chip() {
                     }
                 }
             }
-            if (!any_tensix) {
-                break; // no Tensix instructions executed, bail out
-            }
+            break;
         }
         if (!t_tile_active(p_tile)) {
             g_t_tiles_busy[tile_id / 64] &= ~(1ull << (tile_id % 64));
@@ -290,9 +289,8 @@ static void clock_current_chip() {
         uint32_t tile_id = core_index / RV32_CORES_PER_E_TILE;
         uint32_t rv32_index = core_index % RV32_CORES_PER_E_TILE;
         auto *p_hart = &g_e_tiles[tile_id].rv32[rv32_index];
-        // Hack: for simulator perf, an eth core busy lately (its sram written to, or it issued a NOC or eth command)
-        // takes several steps per clock, so relayed traffic doesn't wait on it; an idle one takes one
-        uint32_t steps = (g_clock < g_e_tiles[tile_id].busy_until) ? ETH_BUSY_STEPS : 1;
+        // Unit tick: an eth core takes one step per clock, busy or not (upstream gives a busy one several)
+        uint32_t steps = 1;
         for (uint32_t i = 0; (i < steps) && ((g_rv32_cores_active >> core_index) & 1); i++) {
             rv32_step(p_hart);
         }
diff --git a/src/tensix.cpp b/src/tensix.cpp
index 88fd5cc..5409128 100644
--- a/src/tensix.cpp
+++ b/src/tensix.cpp
@@ -3188,7 +3188,6 @@ TENSIX_EXECUTE_UNPACR() {
 #endif
     TTSIM_VERIFY(ovrd_thread_id, UnsupportedFunctionality, "ovrd_thread_id=%d", ovrd_thread_id);
     TTSIM_VERIFY(!addr_cnt_context_id, UnsupportedFunctionality, "addr_cnt_context_id=%d", addr_cnt_context_id);
-    TTSIM_VERIFY(!cfg_context_id, UnsupportedFunctionality, "cfg_context_id=%d", cfg_context_id);
     TTSIM_VERIFY(!cfg_context_cnt_inc, UnsupportedFunctionality, "cfg_context_cnt_inc=%d", cfg_context_cnt_inc);

     uint32_t src_bank = unpack_block_selection ? p_tensix->src_b_unpack_bank : p_tensix->src_a_unpack_bank;
@@ -3199,10 +3198,19 @@ TENSIX_EXECUTE_UNPACR() {

     uint32_t state_id = get_state_id(p_tensix, pipe);
     const TensixConfigState *p_config = &p_tensix->config[state_id];
+    // TEN-3868's trailing zero fill publishes no SrcA data and advances no ADC.
+    // Its context number can add to an offset of 1, but no context data is used.
+    if (zero_write2 && !set_dat_valid && !unpack_block_selection && !addr_mode && cfg_context_id <= 1 &&
+        bits<3,0>(p_config->THCON_SEC0_REG0_TileDescriptor) == 0 &&
+        p_config->THCON_SEC0_REG2_Out_data_format == 0 &&
+        !(cfg_context_id ? p_config->THCON_SEC0_REG2_Unpack_if_sel_cntx1
+                        : p_config->THCON_SEC0_REG2_Unpack_if_sel_cntx0)) {
+        return true;
+    }
     uint32_t unpack_context = 0;
     if (ovrd_thread_id) {
-        unpack_context = unpack_block_selection ? p_tensix->thread[pipe].UNPACK_MISC_CFG_CfgContextOffset_1
-                                                : p_tensix->thread[pipe].UNPACK_MISC_CFG_CfgContextOffset_0;
+        unpack_context = cfg_context_id + (unpack_block_selection ? p_tensix->thread[pipe].UNPACK_MISC_CFG_CfgContextOffset_1
+                                                : p_tensix->thread[pipe].UNPACK_MISC_CFG_CfgContextOffset_0);
     }
     TTSIM_VERIFY(unpack_context <= 1, UnsupportedFunctionality, "unpack_context=%d", unpack_context);

@@ -3504,9 +3512,16 @@ TENSIX_EXECUTE_UNPACR() {
             value = uint32_t(bfp8_to_bf16(value, exp_bits)) << 16; // bfp8 -> bf16 -> fp32 in Src
         } else if (in_data_format == 0) { // fp32
             if (out_data_format == 0) { // fp32
-                TTSIM_VERIFY(unpack_to_dst, UndefinedBehavior, "unpack_to_dst=%d in_data_format=%d out_data_format=%d",
-                    unpack_to_dst, in_data_format, out_data_format);
-                value = dst_encode_fp32(value);
+                if (unpack_to_dst) {
+                    value = dst_encode_fp32(value);
+                } else {
+                    // TEN-3868: LLK follows unpack-to-dest with an unused SrcA write.
+                    // Keep readable fp32 Src unsupported; Src stores only TF32 precision.
+                    TTSIM_VERIFY(!set_dat_valid, UndefinedBehavior,
+                        "unpack_to_dst=%d in_data_format=%d out_data_format=%d",
+                        unpack_to_dst, in_data_format, out_data_format);
+                    value &= 0xFFFFE000;
+                }
             } else if (out_data_format == 1) { // fp16
                 TTSIM_VERIFY(!unpack_to_dst, UnsupportedFunctionality, "unpack_to_dst=%d in_data_format=%d out_data_format=%d",
                     unpack_to_dst, in_data_format, out_data_format);
@@ -3585,8 +3600,13 @@ TENSIX_EXECUTE_UNPACR() {
             }
         }
         if (zero_write2) {
-            TTSIM_ERROR(UntestedFunctionality, "zero_write2=%d", zero_write2);
-            value = 0;
+            // The unused TEN-3868 Src write also requests zero fill.
+            TTSIM_VERIFY(!unpack_to_dst && !unpack_block_selection && !set_dat_valid &&
+                in_data_format == 0 && out_data_format == 0,
+                UntestedFunctionality, "zero_write2=%d", zero_write2);
+            // TEN-3868 leaves a Dst address in the unpacker, possibly past SrcA.
+            // No Dvalid is published, so the workaround's zero fill is never read.
+            continue;
         }
         uint32_t row = (dst_addr + i) / ROW_SIZE;
         uint32_t col = (dst_addr + i) % ROW_SIZE;
